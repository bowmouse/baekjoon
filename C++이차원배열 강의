#include<iostream>
using namespace std;
int s[3][5] = { 
	            {0, 1, 2, 3, 4},
				{10, 11, 12, 13, 14},
				{20, 21, 22, 23, 24} 
              };
int law = 0;
int culum = 0;
int i;
int j;

void exercise1() {
	cout << "실습 1" << endl;
	int zero_one;
	for (law = 0; law < 3; law++) {
		for (culum = 0; culum < 5; culum++) {
			
			cout << "s[" << law << "][" << culum << "] = " << s[law][culum] << "\t";
		}
		cout << endl;
	}
	cout << endl;
	cout << "행 출력 원하면 1입력, 열 출력 원하면 0입력" << endl;
	while (1) {
		cin >> zero_one;
		if (zero_one == 1) {
			cout << "1 ~ 3 행 중 몇 행?" << endl;
			cin >> law;
			while (law > 3) {
				cout << "그런 행은 없음 재입력 ㅅㄱ" << endl;
				cin >> law;
				if (law <= 3) {
					break;
				}
			}
			for (j = 1; j <= 5; j++) {
				cout << "s[" << law << "][" << j - 1 << "] = " << s[law][j - 1] << "\t";
			}
			break;
		}
		else if (zero_one == 0) {
			cout << "1 ~ 5 열 중 몇 열?" << endl;
			cin >> culum;
			while (culum > 5) {
				cout << "그런 열은 없음 재입력 ㅅㄱ" << endl;
				cin >> culum;
				if (culum <= 5) {
					break;
				}
			}
			for (i = 1; i <= 3; i++) {
				cout << "s[" << i - 1 << "][" << culum << "] = " << s[i - 1][culum] << endl<<endl;
			}
			break;
		}
		else {
			cout << "나 컴퓨터라 1하고 0 밖에 못 알아 듣는다 미개한 인간들아"<<endl;
			continue;
		}
	}
	cout << endl;
}
